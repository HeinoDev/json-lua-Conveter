<html>
  <head>
    <meta charset="UTF-8" />
    <title>json lua tool</title>
    <meta http-equiv="x-ua-compatible" content="IE=11" />
    <HTA:APPLICATION
      APPLICATIONNAME="json-lua-tool"
      BORDER="thick"
      CAPTION="yes"
      MAXIMIZEBUTTON="yes"
      MINIMIZEBUTTON="yes"
      SHOWINTASKBAR="yes"
      SINGLEINSTANCE="yes"
      SYSMENU="yes"
      WINDOWSTATE="normal"
      SCROLL="no"
    />
    <style>
      * {
        box-sizing: border-box;
      }
      html {
        font-size: 16px;
      }
      body {
        margin: 0;
        height: 100%;
        background: #0d0f13;
        color: #ccd0d8;
        font-family:
          Segoe UI,
          Tahoma,
          sans-serif;
        padding: 1.25rem;
        overflow: hidden;
      }
      .top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
      }
      .top h1 {
        font-size: 1rem;
        font-weight: 700;
        color: #a0a7b3;
        margin: 0;
        letter-spacing: -0.01em;
      }
      .top h1 span {
        color: #6366f1;
        font-weight: 600;
      }
      .tabs {
        display: flex;
        gap: 0.375rem;
        background: #1a1d25;
        padding: 0.375rem;
        border-radius: 0.1875rem;
      }
      .tabs button {
        background: transparent;
        border: 0.0625rem solid transparent;
        color: #7a7f8a;
        padding: 0.5rem 1rem;
        font-size: 0.75rem;
        cursor: pointer;
        border-radius: 0.1875rem;
        font-weight: 500;
        outline: none;
      }
      .tabs button:hover {
        background: #252a33;
        color: #9ca3b0;
      }
      .tabs button.active {
        background: #3b82f6;
        border-color: #3b82f6;
        color: #ffffff;
        font-weight: 600;
      }
      .lang-btns {
        display: flex;
        gap: 0.375rem;
      }
      .lang-btns button {
        background: transparent;
        border: 0.0625rem solid #262b35;
        color: #7a7f8a;
        padding: 0.4rem 0.75rem;
        font-size: 0.6875rem;
        cursor: pointer;
        border-radius: 0.1875rem;
        font-weight: 600;
        outline: none;
        text-transform: uppercase;
        letter-spacing: 0.01em;
      }
      .lang-btns button:hover {
        background: #1a1d25;
        border-color: #353d4a;
        color: #9ca3b0;
      }
      .lang-btns button.active {
        background: #3b82f6;
        border-color: #3b82f6;
        color: #ffffff;
      }
      .grid {
        display: table;
        width: 100%;
        height: calc(100vh - 13rem);
        table-layout: fixed;
        border-spacing: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .col {
        display: table-cell;
        width: 50%;
        vertical-align: top;
      }
      .box {
        background: #12141a;
        border: 0.0625rem solid #20242e;
        border-radius: 0.1875rem;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
      }
      .box .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        border-bottom: 0.0625rem solid #20242e;
        font-size: 0.6875rem;
        color: #5c626c;
        flex-shrink: 0;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        font-weight: 600;
      }
      .box .head button {
        background: none;
        border: none;
        color: #5c626c;
        cursor: pointer;
        font-size: 0.6875rem;
        padding: 0.375rem 0.75rem;
        border-radius: 0.1875rem;
        text-transform: uppercase;
        font-weight: 600;
        margin-left: 0.5rem;
        outline: none;
      }
      .box .head button:hover {
        background: #1a1d25;
        color: #8a909a;
      }
      textarea {
        width: 100%;
        height: calc(100% - 3.25rem);
        background: transparent;
        border: none;
        color: #ccd0d8;
        font-family: "Consolas", "Monaco", monospace;
        font-size: 0.75rem;
        padding: 1rem;
        resize: none;
        outline: none;
        scrollbar-width: thin;
        scrollbar-color: #353d4a transparent;
      }
      textarea::placeholder {
        color: #404854;
      }
      textarea::-webkit-scrollbar {
        width: 0.5rem;
      }
      textarea::-webkit-scrollbar-track {
        background: transparent;
      }
      textarea::-webkit-scrollbar-thumb {
        background: #353d4a;
        border-radius: 0.25rem;
      }
      textarea::-webkit-scrollbar-thumb:hover {
        background: #454d5a;
      }
      textarea:focus {
        outline: none;
      }
      .bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1rem;
        flex-shrink: 0;
      }
      .bottom-left {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      #run {
        background: #3b82f6;
        border: 0.0625rem solid #3b82f6;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.625rem 1.5rem;
        cursor: pointer;
        border-radius: 0.1875rem;
        text-transform: uppercase;
        letter-spacing: 0.01em;
        outline: none;
      }
      #run:hover {
        background: #2563eb;
        border-color: #2563eb;
      }
      #run:active {
        background: #1d4ed8;
      }
      #err {
        font-size: 0.75rem;
        color: #f87171;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <div class="top">
      <h1>json <span>&lt;-&gt;</span> lua</h1>
      <div class="tabs">
        <button id="btnJL" class="active"></button>
        <button id="btnLJ"></button>
      </div>
    </div>

    <div class="grid">
      <div class="col">
        <div class="box">
          <div class="head">
            <span id="inLabel"></span>
            <button id="copyIn"></button>
          </div>
          <textarea id="input" spellcheck="false"></textarea>
        </div>
      </div>
      <div class="col">
        <div class="box">
          <div class="head">
            <span id="outLabel"></span>
            <button id="copyOut"></button>
          </div>
          <textarea id="output" spellcheck="false" readonly></textarea>
        </div>
      </div>
    </div>

    <div class="bottom">
      <div class="bottom-left">
        <button id="run"></button>
        <span id="err"></span>
      </div>
      <div class="lang-btns">
        <button id="langEn" class="active">EN</button>
        <button id="langDa">DA</button>
      </div>
    </div>

    <script language="javascript">
      window.resizeTo(1020, 620);
      window.moveTo((screen.width - 1020) / 2, (screen.height - 620) / 2);

      var LOCALES = {
        en: {
          tabJL: "json -> lua",
          tabLJ: "lua -> json",
          inJson: "json in",
          inLua: "lua in",
          outJson: "json out",
          outLua: "lua out",
          copy: "copy",
          copied: "copied!",
          run: "convert",
          placeholder: "Paste your JSON or Lua here",
          jsonError: "Invalid JSON",
          luaError: "Invalid Lua",
          unexpectedChar: "Unexpected character",
          unexpectedEnd: "Unexpected end of input",
          invalidNumber: "Invalid number",
          missingBracket: "Missing closing bracket",
          inputTooLarge: "Input too large (max 1MB)",
          nestingTooDeep: "Nesting too deep (max 100 levels)",
          invalidEncoding: "Invalid character encoding",
        },
        da: {
          tabJL: "json -> lua",
          tabLJ: "lua -> json",
          inJson: "json in",
          inLua: "lua in",
          outJson: "json out",
          outLua: "lua out",
          copy: "kopier",
          copied: "kopieret!",
          run: "konverter",
          placeholder: "Indsæt din JSON eller Lua her",
          jsonError: "Ugyldig JSON",
          luaError: "Ugyldig Lua",
          unexpectedChar: "Uventet tegn",
          unexpectedEnd: "Uventet slutning på input",
          invalidNumber: "Ugyldigt tal",
          missingBracket: "Manglende lukkeklamme",
          inputTooLarge: "Input for stor (max 1MB)",
          nestingTooDeep: "Indlejring for dyb (max 100 niveauer)",
          invalidEncoding: "Ugyldig tegnkodning",
        },
      };

      var dir = "jl";
      var lang = "en";

      var input = document.getElementById("input");
      var output = document.getElementById("output");
      var errEl = document.getElementById("err");
      var btnJL = document.getElementById("btnJL");
      var btnLJ = document.getElementById("btnLJ");
      var inLabel = document.getElementById("inLabel");
      var outLabel = document.getElementById("outLabel");
      var copyIn = document.getElementById("copyIn");
      var copyOut = document.getElementById("copyOut");
      var runBtn = document.getElementById("run");
      var langEn = document.getElementById("langEn");
      var langDa = document.getElementById("langDa");

      var luaKeywords = [
        "and",
        "break",
        "do",
        "else",
        "elseif",
        "end",
        "false",
        "for",
        "function",
        "if",
        "in",
        "local",
        "nil",
        "not",
        "or",
        "repeat",
        "return",
        "then",
        "true",
        "until",
        "while",
      ];

      function isValidIdent(s) {
        return (
          /^[A-Za-z_][A-Za-z0-9_]*$/.test(s) &&
          indexOfArr(luaKeywords, s) === -1
        );
      }

      function indexOfArr(arr, val) {
        for (var i = 0; i < arr.length; i++) {
          if (arr[i] === val) return i;
        }
        return -1;
      }

      function luaStr(s) {
        return (
          "'" +
          String(s)
            .replace(/\\/g, "\\\\")
            .replace(/'/g, "\\'")
            .replace(/\n/g, "\\n") +
          "'"
        );
      }

      function repeatStr(s, n) {
        var out = "";
        for (var i = 0; i < n; i++) out += s;
        return out;
      }

      function jsonToLua(val, depth) {
        depth = depth || 0;
        var pad = repeatStr("    ", depth);
        var padIn = repeatStr("    ", depth + 1);

        if (val === null || val === undefined) return "nil";
        if (typeof val === "boolean") return val ? "true" : "false";
        if (typeof val === "number") return String(val);
        if (typeof val === "string") return luaStr(val);

        if (Object.prototype.toString.call(val) === "[object Array]") {
          if (val.length === 0) return "{}";
          var items = [];
          for (var i = 0; i < val.length; i++) {
            items.push(padIn + jsonToLua(val[i], depth + 1));
          }
          return "{\n" + items.join(",\n") + "\n" + pad + "}";
        }

        if (typeof val === "object") {
          var keys = [];
          for (var k in val) {
            if (val.hasOwnProperty(k)) keys.push(k);
          }
          if (keys.length === 0) return "{}";
          var lines = [];
          for (var j = 0; j < keys.length; j++) {
            var key = keys[j];
            var keyStr = isValidIdent(key) ? key : "[" + luaStr(key) + "]";
            lines.push(padIn + keyStr + " = " + jsonToLua(val[key], depth + 1));
          }
          return "{\n" + lines.join(",\n") + "\n" + pad + "}";
        }

        return "nil";
      }

      function getLineCol(str, pos) {
        var line = 1;
        var col = 1;
        for (var i = 0; i < pos && i < str.length; i++) {
          if (str.charAt(i) === "\n") {
            line++;
            col = 1;
          } else {
            col++;
          }
        }
        return { line: line, col: col };
      }

      function parseLua(str) {
        var pos = 0;
        var len = str.length;

        function skipWs() {
          while (pos < len) {
            var c = str.charAt(pos);
            if (/\s/.test(c)) {
              pos++;
              continue;
            }
            if (c === "-" && str.charAt(pos + 1) === "-") {
              pos += 2;
              if (str.charAt(pos) === "[" && str.charAt(pos + 1) === "[") {
                pos += 2;
                var blockEnd = str.indexOf("]]", pos);
                if (blockEnd === -1) {
                  // Unclosed block comment, skip to end
                  pos = len;
                } else {
                  pos = blockEnd + 2;
                }
              } else {
                // Line comment, skip until newline
                var nlPos = str.indexOf("\n", pos);
                pos = nlPos === -1 ? len : nlPos;
              }
              continue;
            }
            break;
          }
        }

        function parseString() {
          var q = str.charAt(pos);
          var startPos = pos;
          pos++;
          var out = "";
          while (pos < len && str.charAt(pos) !== q) {
            if (str.charAt(pos) === "\\") {
              var n = str.charAt(pos + 1);
              if (n === "n") out += "\n";
              else if (n === "t") out += "\t";
              else out += n;
              pos += 2;
            } else {
              out += str.charAt(pos);
              pos++;
            }
          }
          if (pos >= len) {
            var err = new Error("Unterminated string");
            err.pos = startPos;
            throw err;
          }
          pos++;
          return out;
        }

        function parseNumber() {
          var startPos = pos;
          var isNegative = false;

          if (str.charAt(pos) === "-") {
            isNegative = true;
            pos++;
          }

          // Try hex (0x/0X)
          if (str.charAt(pos) === "0" && /[xX]/.test(str.charAt(pos + 1))) {
            var m = /^[0-9a-fA-F]+/.exec(str.slice(pos + 2));
            if (m && m[0].length > 0) {
              pos += 2 + m[0].length;
              return isNegative ? -parseInt(m[0], 16) : parseInt(m[0], 16);
            }
          }

          // Try binary (0b/0B)
          if (str.charAt(pos) === "0" && /[bB]/.test(str.charAt(pos + 1))) {
            var m = /^[01]+/.exec(str.slice(pos + 2));
            if (m && m[0].length > 0) {
              pos += 2 + m[0].length;
              return isNegative ? -parseInt(m[0], 2) : parseInt(m[0], 2);
            }
          }

          // Decimal numbers
          var m = /^\d+(\.\d+)?([eE][+-]?\d+)?/.exec(str.slice(pos));
          if (!m || m[0].length === 0) {
            var err = new Error("Invalid number");
            err.pos = startPos;
            throw err;
          }
          pos += m[0].length;
          var num = Number(m[0]);
          return isNegative ? -num : num;
        }

        function parseIdent() {
          var m = /^[A-Za-z_][A-Za-z0-9_]*/.exec(str.slice(pos));
          pos += m[0].length;
          return m[0];
        }

        function parseTable() {
          var startPos = pos;
          pos++;
          var arr = [];
          var obj = {};
          var isArray = true;

          while (true) {
            skipWs();
            if (str.charAt(pos) === "}") {
              pos++;
              break;
            }
            if (pos >= len) {
              var err = new Error("Missing closing bracket for table");
              err.pos = startPos;
              throw err;
            }

            var key = null;

            if (str.charAt(pos) === "[") {
              pos++;
              skipWs();
              key = parseValue();
              skipWs();
              if (str.charAt(pos) === "]") pos++;
              skipWs();
              if (str.charAt(pos) === "=") pos++;
            } else if (/[A-Za-z_]/.test(str.charAt(pos))) {
              var save = pos;
              var ident = parseIdent();
              skipWs();
              if (
                str.charAt(pos) === "=" &&
                indexOfArr(luaKeywords, ident) === -1
              ) {
                key = ident;
                pos++;
              } else {
                pos = save;
              }
            }

            skipWs();
            var val = parseValue();

            if (key !== null) {
              isArray = false;
              obj[key] = val;
            } else {
              arr.push(val);
            }

            skipWs();
            if (str.charAt(pos) === "," || str.charAt(pos) === ";") pos++;
          }

          return isArray ? arr : obj;
        }

        function parseValue() {
          skipWs();
          if (pos >= len) {
            var err = new Error("Unexpected end of input");
            err.pos = pos;
            throw err;
          }
          var c = str.charAt(pos);
          if (c === "{") return parseTable();
          if (c === '"' || c === "'") return parseString();
          if (
            /[0-9]/.test(c) ||
            (c === "-" && /[0-9]/.test(str.charAt(pos + 1)))
          )
            return parseNumber();
          if (/[A-Za-z_]/.test(c)) {
            var w = parseIdent();
            if (w === "true") return true;
            if (w === "false") return false;
            if (w === "nil") return null;
            return w;
          }
          var err = new Error("Unexpected character '" + c + "'");
          err.pos = pos;
          throw err;
        }

        skipWs();
        var ret = /^return\s+/.exec(str.slice(pos));
        if (ret) pos += ret[0].length;
        skipWs();

        var result = parseValue();
        if (pos < len) {
          skipWs();
          if (pos < len) {
            var err = new Error("Extra characters after value");
            err.pos = pos;
            throw err;
          }
        }
        return result;
      }

      function applyLocale() {
        var t = LOCALES[lang];
        btnJL.innerText = t.tabJL;
        btnLJ.innerText = t.tabLJ;
        copyIn.innerText = t.copy;
        copyOut.innerText = t.copy;
        runBtn.innerText = t.run;
        input.placeholder = t.placeholder;
        inLabel.innerText = dir === "jl" ? t.inJson : t.inLua;
        outLabel.innerText = dir === "jl" ? t.outLua : t.outJson;
        if (lang === "en") {
          langEn.className = "active";
          langDa.className = "";
        } else {
          langDa.className = "active";
          langEn.className = "";
        }
      }

      function setDir(d) {
        dir = d;
        if (d === "jl") {
          btnJL.className = "active";
          btnLJ.className = "";
        } else {
          btnLJ.className = "active";
          btnJL.className = "";
        }
        errEl.innerText = "";
        applyLocale();
      }

      var MAX_SIZE = 1024 * 1024;
      var MAX_DEPTH = 100;

      function validateInput(str) {
        if (!str || str.trim().length === 0) return null;

        if (str.length > MAX_SIZE) {
          var err = new Error(LOCALES[lang].inputTooLarge);
          err.validation = true;
          throw err;
        }

        try {
          for (var i = 0; i < str.length; i++) {
            str.charCodeAt(i);
          }
        } catch (e) {
          var err = new Error(LOCALES[lang].invalidEncoding);
          err.validation = true;
          throw err;
        }

        return str;
      }

      function checkDepth(val, depth) {
        if (depth > MAX_DEPTH) {
          var err = new Error(LOCALES[lang].nestingTooDeep);
          err.validation = true;
          throw err;
        }

        if (typeof val === "object" && val !== null) {
          for (var k in val) {
            if (val.hasOwnProperty(k)) {
              checkDepth(val[k], depth + 1);
            }
          }
        }
      }

      var convertTimeout;
      function convert() {
        errEl.innerText = "";
        var raw = input.value.trim();

        if (!raw) {
          output.value = "";
          return;
        }

        try {
          validateInput(raw);

          if (dir === "jl") {
            var parsed = JSON.parse(raw);
            checkDepth(parsed, 0);
            output.value = jsonToLua(parsed, 0);
          } else {
            var val = parseLua(raw);
            checkDepth(val, 0);
            output.value = JSON.stringify(val, null, 2);
          }
          saveState();
        } catch (e) {
          if (e.validation) {
            errEl.innerText = e.message;
          } else {
            var lineCol = getLineCol(raw, e.pos || 0);
            var errorType =
              dir === "jl" ? LOCALES[lang].jsonError : LOCALES[lang].luaError;
            errEl.innerText =
              errorType +
              " (Line " +
              lineCol.line +
              ", Col " +
              lineCol.col +
              "): " +
              e.message;
          }
        }
      }

      function autoConvert() {
        clearTimeout(convertTimeout);
        convertTimeout = setTimeout(convert, 500);
      }

      function copyBox(box) {
        var text = box.value;
        if (!text) return;

        navigator.clipboard
          .writeText(text)
          .then(function () {
            var btn = box === input ? copyIn : copyOut;
            var origText = btn.innerText;
            btn.innerText = LOCALES[lang].copied;
            setTimeout(function () {
              btn.innerText = origText;
            }, 2000);
          })
          .catch(function (e) {
            alert("Failed to copy: " + e.message);
          });
      }

      function saveState() {
        try {
          localStorage.setItem("jsonLuaDir", dir);
          localStorage.setItem("jsonLuaLang", lang);
          localStorage.setItem("jsonLuaInput", input.value);
          localStorage.setItem("jsonLuaOutput", output.value);
        } catch (e) {
          // localStorage not available
        }
      }

      function loadState() {
        try {
          var savedDir = localStorage.getItem("jsonLuaDir");
          var savedLang = localStorage.getItem("jsonLuaLang");
          var savedOutput = localStorage.getItem("jsonLuaOutput");

          if (savedDir) dir = savedDir;
          if (savedLang) {
            lang = savedLang;
            langSel.value = lang;
          }
          if (savedOutput) output.value = savedOutput;
        } catch (e) {
          // localStorage not available
        }
      }

      btnJL.onclick = function () {
        setDir("jl");
        convert();
      };
      btnLJ.onclick = function () {
        setDir("lj");
        convert();
      };
      runBtn.onclick = convert;
      input.onchange = autoConvert;
      input.oninput = autoConvert;
      copyIn.onclick = function () {
        copyBox(input);
      };
      copyOut.onclick = function () {
        copyBox(output);
      };
      langEn.onclick = function () {
        lang = "en";
        applyLocale();
        saveState();
      };
      langDa.onclick = function () {
        lang = "da";
        applyLocale();
        saveState();
      };

      document.onkeydown = function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
          e.preventDefault();
          convert();
        }
      };

      loadState();
      applyLocale();
      setDir(dir);
      convert();
    </script>
  </body>
</html>
